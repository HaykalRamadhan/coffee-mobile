# Safe client-side values from Supabase Dashboard > Connect
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# App-wide maintenance display. Accepted enabled values: true, 1, yes, or on.
EXPO_PUBLIC_MAINTENANCE_MODE=false
EXPO_PUBLIC_MAINTENANCE_MESSAGE=We are tuning the machines and charging up something better. Please check back shortly.

# Never put Supabase secret keys, service-role keys, or Midtrans server keys here.
