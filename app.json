{
  "expo": {
    "name": "KopiPow",
    "owner": "lrxn",
    "slug": "kopipow",
    "scheme": "kopipow",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e755f1c3-91d3-4ec2-8761-a87026a80704",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "android": {
      "package": "com.kopipow.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F36B35"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kopipow.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e755f1c3-91d3-4ec2-8761-a87026a80704"
      }
    }
  }
}
