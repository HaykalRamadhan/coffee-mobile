{
  "expo": {
    "name": "KopiPow",
    "slug": "kopipow",
    "scheme": "kopipow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F1E7",
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#EEEBCB"
    },
    "android": {
      "package": "com.kopipow.app",
      "adaptiveIcon": {
        "backgroundColor": "#F36B35"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kopipow.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-font"
    ]
  }
}
